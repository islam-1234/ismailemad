rules_version = '2';

// ============================================================
// firestore.rules
// ------------------------------------------------------------
// منصة أ/ إسماعيل عماد التعليمية
// قواعد أمان Firestore
//
// المكان: /firestore.rules
//
// المرجع:
//   - الوثيقة الأصلية (بنود 43، 104، 107، 108، 109، 127، 128، 129)
//   - Firebase Security Rules Documentation
//
// ⚠️ ملاحظات مهمة:
//   1. الـ Worker Admin SDK يتخطى هذه القواعد تمامًا.
//   2. الفرونت لا يكلم Firestore مباشرة — كل شيء عبر Worker.
//   3. هذه القواعد طبقة أمان إضافية.
//
// القاعدة الذهبية:
//   ❌ رفض كل شيء افتراضيًا.
//   ✅ السماح فقط لما هو مصرح به صريح.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // 01 — Helper Functions
    // ==========================================================
    
    // هل الطلب من الأدمن (Admin SDK)؟
    // ملاحظة: Admin SDK يتخطى القواعد — الدالة دي للحالات النادرة.
    function isAdminSdk() {
      return request.auth == null;
    }
    
    // هل المستخدم مسجل دخول؟
    function isSignedIn() {
      return request.auth != null;
    }
    
    // هل المستخدم صاحب هذا الـ UID؟
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // ==========================================================
    // 02 — RULES — رفض افتراضي
    // ==========================================================
    // أي collection مش محددة أدناه = ممنوعة تمامًا.
    // ==========================================================

    // ==========================================================
    // 03 — Collection: codes
    // الأكواد — سرية تمامًا
    // لا أحد يقرأ أو يكتب من الفرونت.
    // ==========================================================
    match /codes/{codeId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 04 — Collection: students
    // الطلاب — لا أحد يقرأ أو يكتب من الفرونت.
    // ==========================================================
    match /students/{studentId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 05 — Collection: admins
    // الإداريون — سرية تمامًا.
    // ==========================================================
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 06 — Collection: announcements
    // الإعلانات — سرية من الفرونت.
    // ==========================================================
    match /announcements/{announcementId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 07 — Collection: announcementReplies
    // الردود — سرية من الفرونت.
    // ==========================================================
    match /announcementReplies/{replyId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 08 — Collection: lessons
    // الدروس — سرية من الفرونت.
    // ==========================================================
    match /lessons/{lessonId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 09 — Collection: exams
    // الاختبارات — تحتوي على correctIndex — سرية تمامًا.
    // المرجع: بند 43 (الإجابات الصحيحة لا تكشف للطالب).
    // ==========================================================
    match /exams/{examId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 10 — Collection: examAttempts
    // المحاولات — لا أحد يقرأ أو يكتب من الفرونت.
    // ==========================================================
    match /examAttempts/{attemptId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 11 — Collection: planner
    // المنظم — سرية من الفرونت.
    // ==========================================================
    match /planner/{plannerId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 12 — Collection: studySessions
    // جلسات المذاكرة — سرية من الفرونت.
    // ==========================================================
    match /studySessions/{sessionId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 13 — Collection: aiUsage
    // استخدام AI — سرية من الفرونت.
    // ==========================================================
    match /aiUsage/{usageId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 14 — Collection: lessonGroups
    // مجموعات الدروس — سرية من الفرونت.
    // ==========================================================
    match /lessonGroups/{groupId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 15 — Collection: subscriptionRequests
    // طلبات الاشتراك — سرية من الفرونت.
    // ==========================================================
    match /subscriptionRequests/{requestId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 16 — Collection: settings
    // الإعدادات — سرية من الفرونت.
    // ==========================================================
    match /settings/{settingId} {
      allow read, write: if false;
    }

    // ==========================================================
    // 17 — أي Collection غير محددة
    // ممنوعة تمامًا (رفض افتراضي).
    // ==========================================================
    match /{document=**} {
      allow read, write: if false;
    }

  }
}

// ============================================================
// ملاحظات مهمة حول هذه القواعد
// ============================================================
//
// 1. الـ Worker Admin SDK يتخطى هذه القواعد تمامًا.
//    يعني الـ Worker يقدر يقرا ويكتب بحرية.
//
// 2. الفرونت (HTML/CSS/JS) لا يكلم Firestore مباشرة.
//    كل شيء عبر Worker.
//
// 3. لو حصل تسريب في Firebase Config (apiKey، projectId)،
//    ما يقدرش أحد يقرا أو يكتب أي بيانات.
//
// 4. الـ `allow read, write: if false` = رفض صريح.
//
// 5. القاعدة الأخيرة `match /{document=**}` = catch-all
//    لأي collection مش محددة.
//
// 6. لو احتاجنا لاحقًا نسمح للطالب بقراءة بياناته مباشرة
//    (مش عبر Worker)، نعدّل القواعد.
//
// 7. لتطبيق القواعد:
//    firebase deploy --only firestore:rules
//    أو من Firebase Console → Firestore → Rules.
//
// ============================================================
// END OF RULES
// ============================================================